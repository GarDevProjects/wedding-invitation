---
import Layout from "../layouts/Layout.astro";
import Photo from "./Photo.astro";
import RsvpForm from "./RsvpForm";
import { wedding } from "../config/wedding";
import { display } from "../lib/dates";
import { getImage } from 'astro:assets';
const galleryPhotos = await Promise.all(wedding.gallery.map(async photo => ({
  ...photo,
  full: (await getImage({ src: photo.src, width: Math.min(1600, photo.src.width), format: 'webp', quality: 82 })).src,
})));
---
<Layout>
<dialog class="opening" aria-labelledby="opening-title"><div class="opening__inner"><p class="eyebrow">Una invitación para ti</p><p class="opening__monogram">A<span>&</span>M</p><h2 id="opening-title">Nuestro para siempre</h2><p>{display.partnerOne} & {display.partnerTwo}</p><p data-personalized-welcome hidden></p><p>{display.shortDate}</p><button class="button button--dark" type="button" data-open-invitation>Abrir invitación</button><p class="fine-print">La música es opcional. Actívala cuando quieras.</p></div></dialog>
    <a class="skip-link" href="#main-content">Saltar al contenido</a>

    <div class="site-grain" aria-hidden="true"></div>

    <header class="hero" id="inicio">
      <Photo src={wedding.images.hero} alt={wedding.imageAlt.hero} class="hero__image" hero />
      <div class="hero__veil" aria-hidden="true"></div>

      <nav class="topbar" aria-label="Navegación principal">
        <a class="monogram" href="#inicio" aria-label="Ir al inicio">M<span>&</span>A</a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="nav-links">
          <span>Menú</span>
          <i aria-hidden="true"></i>
        </button>
        <div class="nav-links" id="nav-links">
          <a href="#fecha">La fecha</a>
          <a href="#detalles">Detalles</a>
          <a href="#regalos">Regalos</a>
          <a href="#confirmacion">Confirmar</a>
        </div>
      </nav>

      <div class="hero__content">
        <p class="eyebrow hero__eyebrow">Tenemos algo que celebrar</p>
        <h1 class="hero__names">
          <span data-text="partnerOne">{display.partnerOne}</span>
          <em>&</em>
          <span data-text="partnerTwo">{display.partnerTwo}</span>
        </h1>
        <p class="hero__date" data-text="shortDate">{display.shortDate}</p>
        <p class="hero__guest" data-personalized-welcome hidden></p>
      </div>

      <button class="music-button" type="button" aria-pressed="false" aria-label="Reproducir música">
        <span class="music-button__rings" aria-hidden="true"></span>
        <span class="music-button__icon" aria-hidden="true">
          <svg class="icon-play" viewBox="0 0 24 24"><path d="m9 7 8 5-8 5V7Z" /></svg>
          <svg class="icon-pause" viewBox="0 0 24 24"><path d="M8 7h3v10H8zm5 0h3v10h-3z" /></svg>
        </span>
        <span class="music-button__label">Nuestra canción</span>
      </button>

      <a class="scroll-cue" href="#fecha">
        <span>Descubre</span>
        <i aria-hidden="true"></i>
      </a>
    </header>

    <main id="main-content">
      <section class="chapter chapter--date" id="fecha">
        <div class="chapter__content split split--60-40">
          <div class="split__copy reveal">
            <p class="chapter-number">01 / 05</p>
            <p class="eyebrow">Reserva la fecha</p>
            <h2 class="display-title date-display">
              <span data-text="dayName">{display.dayName}</span>
              <strong data-text="dayNumber">{display.dayNumber}</strong>
              <span><span data-text="monthName">{display.monthName}</span> · <span data-text="year">{display.year}</span></span>
            </h2>
            <p class="lead" data-text="invitationMessage">{display.invitationMessage}</p>

            <div class="countdown" aria-label="Cuenta regresiva para la boda">
              <div><strong data-count="days">000</strong><span>Días</span></div>
              <div><strong data-count="hours">00</strong><span>Horas</span></div>
              <div><strong data-count="minutes">00</strong><span>Min</span></div>
              <div><strong data-count="seconds">00</strong><span>Seg</span></div>
            </div>

            <button class="text-link calendar-button" type="button">
              Agendar la fecha <span aria-hidden="true">↗</span>
            </button>
          </div>
          <figure class="split__media portrait-frame reveal reveal--right">
            <Photo src={wedding.images.date} alt={wedding.imageAlt.date} />
            <figcaption>Nuestro para siempre comienza aquí</figcaption>
          </figure>
        </div>
      </section>

      <section class="chapter chapter--dress" id="detalles">
        <div class="botanical botanical--one" aria-hidden="true"></div>
        <div class="chapter__content split split--40-60">
          <figure class="split__media portrait-frame portrait-frame--tall reveal">
            <Photo src={wedding.images.dressCode} alt={wedding.imageAlt.dressCode} />
            <figcaption>Una noche para recordar</figcaption>
          </figure>
          <div class="split__copy reveal reveal--right">
            <p class="chapter-number">02 / 05</p>
            <p class="eyebrow">Dress code</p>
            <h2 class="display-title" data-text="dressCodeTitle">{display.dressCodeTitle}</h2>
            <p class="script-accent">Vístete para celebrar</p>
            <p class="lead" data-text="dressCodeDescription">{display.dressCodeDescription}</p>
            <div class="palette" aria-label="Paleta de colores sugerida">
              <span style="--swatch: #693f3b"><i>Borgoña</i></span>
              <span style="--swatch: #9a7867"><i>Rosa viejo</i></span>
              <span style="--swatch: #baa98e"><i>Champaña</i></span>
              <span style="--swatch: #63705b"><i>Olivo</i></span>
            </div>
            <p class="fine-print" data-text="dressCodeNote">{display.dressCodeNote}</p>
          </div>
        </div>
      </section>

      <section class="chapter chapter--venue" id="ubicacion">
        <div class="chapter__content split split--60-40">
          <div class="split__copy reveal">
            <p class="chapter-number">03 / 05</p>
            <p class="eyebrow">Dónde & cuándo</p>
            <h2 class="display-title" data-text="venueName">{display.venueName}</h2>
            <p class="script-accent" data-text="city">{display.city}</p>

            <div class="event-facts">
              <div>
                <span>Fecha</span>
                <strong data-text="fullDate">{display.fullDate}</strong>
              </div>
              <div>
                <span>Hora</span>
                <strong data-text="time">{display.time}</strong>
              </div>
              <div>
                <span>Dirección</span>
                <strong data-text="venueAddress">{display.venueAddress}</strong>
              </div>
            </div>

            <ol class="event-timeline" aria-label="Programa de la boda">
              {wedding.timeline.map(item => <li><time>{item.time}</time><div><strong>{item.title}</strong><p>{item.detail}</p></div></li>)}
            </ol>
            <div class="button-row">
              <a class="button button--dark" data-link="googleMaps" href={wedding.googleMapsUrl} target="_blank" rel="noopener">
                Abrir en Google Maps <span aria-hidden="true">↗</span>
              </a>
              <a class="button button--dark" data-link="waze" href={wedding.wazeUrl} target="_blank" rel="noopener">
                Abrir en Waze <span aria-hidden="true">↗</span>
              </a>
              <button class="button button--ghost calendar-button" type="button">Agregar al calendario</button>
            </div>
            <p class="fine-print" data-text="transportNote">{display.transportNote}</p>
          </div>
          <figure class="split__media portrait-frame venue-map reveal reveal--right">
            <iframe
              data-map="venue"
              title="Mapa de Sala de Eventos Laureal"
              src={wedding.venueMapEmbedUrl}
              loading="lazy"
              allowfullscreen
              referrerpolicy="no-referrer"
            ></iframe>
            <figcaption>Aquí nos encontraremos</figcaption>
          </figure>
        </div>
      </section>

      <section class="chapter chapter--gifts" id="regalos">
        <div class="botanical botanical--two" aria-hidden="true"></div>
        <div class="chapter__content split split--40-60">
          <figure class="split__media portrait-frame reveal">
            <Photo src={wedding.images.gifts} alt={wedding.imageAlt.gifts} />
            <figcaption>El mejor regalo es compartir contigo</figcaption>
          </figure>
          <div class="split__copy reveal reveal--right">
            <p class="chapter-number">04 / 05</p>
            <p class="eyebrow">Con cariño</p>
            <h2 class="display-title">Regalos</h2>
            <p class="script-accent">Tu presencia es nuestro regalo</p>
            <p class="lead" data-text="giftMessage">{display.giftMessage}</p>

            <div class="gift-card">
              <div class="gift-card__icon" aria-hidden="true">✦</div>
              <div>
                <span>Transferencia o SINPE</span>
                <strong data-text="giftSummary">{display.giftSummary}</strong>
              </div>
              <button class="copy-gift" type="button" data-copy="giftDetails" hidden>Copiar</button>
            </div>
            <p class="privacy-note">
              <span aria-hidden="true">◌</span> Comparte datos bancarios solo cuando el sitio esté listo para tus invitados.
            </p>
          </div>
        </div>
      </section>

      <section class="chapter chapter--rsvp" id="confirmacion">
        <div class="chapter__content split split--60-40">
          <div class="split__copy reveal">
            <p class="chapter-number">05 / 05</p>
            <p class="eyebrow">Acompáñanos</p>
            <h2 class="display-title">Confirma tu asistencia</h2>
            <p class="lead">
              Esta invitación es individual y reserva un lugar para ti. Por favor responde antes del
              <strong data-text="rsvpDeadline">{display.rsvpDeadline}</strong>.
            </p>

            <RsvpForm client:load />
          </div>
          <figure class="split__media portrait-frame portrait-frame--tall reveal reveal--right">
            <Photo src={wedding.images.rsvp} alt={wedding.imageAlt.rsvp} />
            <figcaption>¿Bailamos?</figcaption>
          </figure>
        </div>
      </section>

      <section class="moments" id="momentos">
        <div class="moments__heading reveal">
          <p class="eyebrow">Un poquito de nosotros</p>
          <h2 class="display-title">Nuestros momentos</h2>
          <p>Arrastra, explora y revive la historia con nosotros.</p>
        </div>
        <div class="moments__viewport" tabindex="0" aria-label="Galería de nuestros momentos">
          <div class="moments__track" data-gallery-track style={`--gallery-duration: ${galleryPhotos.length * 7.5}s`}>
{[...galleryPhotos, ...galleryPhotos].map((photo,index) => <figure class="moment-card" tabindex={index < galleryPhotos.length ? 0 : -1} role="button" data-index={index % galleryPhotos.length} data-full-src={photo.full} aria-label={`Ampliar: ${photo.caption}`} aria-hidden={index >= galleryPhotos.length ? "true" : undefined}><Photo src={photo.src} alt={photo.alt} gallery /><figcaption>{photo.caption}</figcaption></figure>)}
</div>
        </div>
      </section>
    </main>

    <footer class="footer">
      <p class="footer__script">Nos vemos en la pista</p>
      <p class="footer__names"><span data-text="partnerOne">{display.partnerOne}</span> <i>&</i> <span data-text="partnerTwo">{display.partnerTwo}</span></p>
      <p class="footer__date" data-text="shortDate">{display.shortDate}</p>
      <a href="#inicio" aria-label="Volver al inicio">↑</a>
    </footer>

    <dialog class="lightbox" aria-label="Vista ampliada de la foto">
      <button class="lightbox__close" type="button" aria-label="Cerrar">×</button>
      <button class="lightbox__nav lightbox__nav--prev" type="button" aria-label="Foto anterior">←</button>
      <img src="" alt="" />
      <button class="lightbox__nav lightbox__nav--next" type="button" aria-label="Foto siguiente">→</button>
      <p></p>
    </dialog>

    
    <noscript>
      <p class="noscript-message">Activa JavaScript para ver la cuenta regresiva y enviar tu confirmación.</p>
    </noscript>

<script>import "../scripts/invitation";</script>
</Layout>
