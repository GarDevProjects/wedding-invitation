---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { src: ImageMetadata; alt: string; class?: string; hero?: boolean; gallery?: boolean }
const { src, alt, class: className, hero = false, gallery = false } = Astro.props;
const width = Math.min(src.width, hero ? 2000 : gallery ? 800 : 1400);
---
<Picture src={src} alt={alt} class={className}
  formats={gallery ? ['webp'] : ['avif', 'webp']} widths={hero ? [640, 960, 1440, 2000] : gallery ? [400, 800] : [480, 960, 1400]}
  width={width} height={Math.round(width * src.height / src.width)}
  sizes={hero ? '100vw' : gallery ? '(max-width: 680px) 70vw, (max-width: 1533px) 24vw, 368px' : '(max-width: 900px) 90vw, 40vw'}
  loading={hero ? 'eager' : 'lazy'} fetchpriority={hero ? 'high' : 'auto'} decoding="async" />
